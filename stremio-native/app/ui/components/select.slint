import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ButtonSurface, ControlIcon } from "button.slint";

// Shared popup select. Its label and option geometry follow the official
// Multiselect, while the string model preserves the native page API.
export component SelectField inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in-out property <string> value;
    in property <string> placeholder: @tr("SELECT" => "Select");
    in property <[string]> options: [];
    // Empty keeps every option enabled, preserving existing callers.
    in property <[bool]> option-enabled: [];
    in-out property <bool> open: false;
    in property <bool> enabled: true;
    in property <length> field-width: 15 * root.unit;
    in property <brush> surface-color: Theme.overlay-color;
    in property <bool> center-contents: false;
    callback toggle;
    callback opened;
    callback closed;
    callback selected(string);

    width: root.field-width;
    height: 2.75 * root.unit;
    clip: true;
    border-radius: root.height / 2;
    background: root.surface-color;
    z: root.open ? 10000 : 0;

    pure function translate-option(val: string) -> string {
        return val == "Side Rail" ? @tr("Side Rail") :
               val == "Top Bar" ? @tr("Top Bar") :
               val == "Minimal" ? @tr("Minimal") :
               val == "Classic Home" ? @tr("Classic Home") :
               val == "Standard" ? @tr("Standard") :
               val == "Kids" ? @tr("Kids") :
               val == "Owner" ? @tr("Owner") :
               val == "Smart" || val == "smart" ? @tr("Smart") :
               val == "Quality" || val == "quality" ? @tr("Quality") :
               val == "Smallest" || val == "smallest" ? @tr("Smallest") :
               val == "Seeders" || val == "seeders" ? @tr("Seeders") :
               val == "Original" || val == "original" ? @tr("Original") :
               val == "Local" ? @tr("Local") :
               val == "Rising" ? @tr("Rising") :
               val == "Most starred" ? @tr("Most starred") :
               val == "Newest" ? @tr("Newest") :
               val == "All categories" ? @tr("All categories") :
               val == "TV shows" ? @tr("TV shows") :
               val == "Live TV" ? @tr("Live TV") :
               val == "Debrid support" ? @tr("Debrid support") :
               val == "HTTP streams" ? @tr("HTTP streams") :
               val == "Metadata" ? @tr("Metadata") :
               val == "Torrents" ? @tr("Torrents") :
               val == "Subtitles" ? @tr("Subtitles") :
               val == "Stremio Addons" ? @tr("Stremio Addons") :
               val == "NSFW" ? @tr("NSFW") :
               val == "Disabled" ? @tr("Disabled") :
               val == "No Caching" ? @tr("No Caching") :
               val == "Infinite" ? @tr("Infinite") :
               val == "Default" ? @tr("Default") :
               val == "Fast" ? @tr("Fast") :
               val == "Ultra Fast" ? @tr("Ultra Fast") :
               val == "Binaural HRTF" ? @tr("Binaural HRTF") :
               val == "7.1 Virtual Surround" ? @tr("7.1 Virtual Surround") :
               val == "3 sec" ? "3 s" : val == "5 sec" ? "5 s" :
               val == "10 sec" ? "10 s" : val == "15 sec" ? "15 s" :
               val == "20 sec" ? "20 s" : val == "25 sec" ? "25 s" :
               val == "30 sec" ? "30 s" : val == "35 sec" ? "35 s" :
               val == "40 sec" ? "40 s" : val == "45 sec" ? "45 s" :
               val == "50 sec" ? "50 s" : val == "55 sec" ? "55 s" :
               val == "60 sec" ? "60 s" :
               val == "All" || val == "all" ? @tr("ALL" => "All") :
               val == "Movies" || val == "movies" ? @tr("Movies" => "Movies") :
               val == "Series" || val == "series" || val == "serie" || val == "Serie" ? @tr("TYPE_series" => "Series") :
               val == "Others" || val == "others" || val == "other" || val == "Other" ? @tr("TYPE_other" => "Other") :
               val == "Movie" || val == "movie" ? @tr("TYPE_movie" => "Movie") :
               val == "Channel" ? @tr("TYPE_channel" => "Channel") :
               val == "TV channel" ? @tr("TYPE_tv" => "TV channel") :
               val == "Other" ? @tr("TYPE_other" => "Other") :
               val == "Last Watched" ? @tr("SORT_LASTWATCHED" => "last watched") :
               val == "A–Z" ? @tr("SORT_NAME" => "a-z") :
               val == "A-Z" ? @tr("SORT_NAME" => "a-z") :
               val == "Z–A" ? @tr("SORT_NAMEREVERSE" => "z-a") :
               val == "Z-a" ? @tr("SORT_NAMEREVERSE" => "z-a") :
               val == "Most Watched" ? @tr("SORT_TIMESWATCHED" => "most watched") :
               val == "Watched" ? @tr("SORT_WATCHED" => "watched") :
               val == "Not Watched" ? @tr("SORT_NOTWATCHED" => "not watched") :
               val == "Type" ? @tr("TYPE" => "Type") :
               val == "Catalog" ? @tr("CATALOG" => "Catalog") :
               val == "Genre" ? @tr("GENRE" => "Genre") :
               val == "Select" ? @tr("SELECT" => "Select") :
               val == "Popular" || val == "popular" || val == "top" ? @tr("CATALOG_com_linvo_cinemeta_top" => "Popular") :
               val == "Featured" ? @tr("CATALOG_com_linvo_cinemeta_imdbRating" => "Featured") :
               val == "New" ? @tr("CATALOG_com_linvo_cinemeta_year" => "New") :
               val == "Public Domain Movies" ? @tr("CATALOG_org_stremio_pubdomainmovies_publicdomainmovies" => "Public Domain Movies") :
               val == "YouTube" ? "YouTube" :
               val == "Action" ? @tr("Action" => "Action") :
               val == "Adventure" ? @tr("Adventure" => "Adventure") :
               val == "Animation" ? @tr("Animation" => "Animation") :
               val == "Biography" ? @tr("Biography" => "Biography") :
               val == "Comedy" ? @tr("COMEDY" => "Comedy") :
               val == "Crime" ? @tr("Crime" => "Crime") :
               val == "Documentary" ? @tr("Documentary" => "Documentary") :
               val == "Drama" ? @tr("Drama" => "Drama") :
               val == "Family" ? @tr("Family" => "Family") :
               val == "Fantasy" ? @tr("Fantasy" => "Fantasy") :
               val == "Film-Noir" ? @tr("Film-Noir" => "Film-Noir") :
               val == "History" ? @tr("History" => "History") :
               val == "Horror" ? @tr("Horror" => "Horror") :
               val == "Music" ? @tr("MUSIC" => "Music") :
               val == "Musical" ? @tr("Musical" => "Musical") :
               val == "Mystery" ? @tr("Mystery" => "Mystery") :
               val == "News" ? @tr("NEWS" => "News") :
               val == "Romance" ? @tr("Romance" => "Romance") :
               val == "Sci-Fi" ? @tr("Sci-Fi" => "Sci-Fi") :
               val == "Sport" ? @tr("Sport" => "Sport") :
               val == "Thriller" ? @tr("Thriller" => "Thriller") :
               val == "War" ? @tr("War" => "War") :
               val == "Western" ? @tr("Western" => "Western") :
               val == "Installed" ? @tr("ADDON_INSTALLED" => "Installed") :
               val == "Community" ? @tr("WEBSITE_COMMUNITY" => "Community") :
               val == "Anime" ? "Anime" :
               val == "TV Channel" ? @tr("TYPE_tv" => "TV channel") :
               val == "Special" ? @tr("SPECIAL" => "Special") :
               val == "Downloads" || val == "downloads" ? @tr("Downloads") : val;
    }

    label-button := ButtonSurface {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        enabled: root.enabled;
        accessible-name: root.value == "" ? translate-option(root.placeholder) : translate-option(root.value);
        clicked => {
            root.open = !root.open;
            root.toggle();
            if (!root.open) {
                popup.close();
                root.closed();
            } else {
                popup.show();
                root.opened();
            }
        }

        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: root.center-contents ? 0.6 * root.unit : 1.25 * root.unit;
            padding-right: root.center-contents ? 0.6 * root.unit : 1.25 * root.unit;
            spacing: 0.4 * root.unit;
            alignment: root.center-contents ? center : stretch;

            Text {
                height: 100%;
                horizontal-stretch: root.center-contents ? 0 : 1;
                text: root.value == "" ? translate-option(root.placeholder) : translate-option(root.value);
                color: Theme.primary-foreground;
                opacity: root.value == "" ? 0.6 : 1;
                font-size: root.unit;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }

            ControlIcon {
                width: 1.1 * root.unit;
                height: 100%;
                size-ratio: 0.5;
                source: root.open
                    ? @image-url("../assets/images/icons/caret-up.svg")
                    : @image-url("../assets/images/icons/caret-down.svg");
                colorize: Theme.primary-foreground;
                icon-opacity: 0.4;
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: root.width;
        height: root.options.length == 0
            ? 3 * root.unit
            : min(root.options.length, 7) * 2.5 * root.unit;

        menu := Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Theme.border-radius;
            background: Theme.modal-color;
            drop-shadow-blur: Theme.outer-glow-blur;
            drop-shadow-color: Theme.outer-glow-color;
            clip: true;

            if (root.options.length == 0) : Text {
                width: parent.width;
                height: parent.height;
                text: @tr("No options");
                color: Theme.surface-light-90;
                font-size: 1.2 * root.unit;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if (root.options.length > 0) : ScrollView {
                width: parent.width;
                height: parent.height;

                VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    spacing: 0px;

                    for option[index] in root.options : option-button := ButtonSurface {
                        horizontal-stretch: 1;
                        height: 2.5 * root.unit;
                        enabled: root.option-enabled.length == 0
                            ? true
                            : (index < root.option-enabled.length ? root.option-enabled[index] : true);
                        accessible-name: translate-option(option);
                        background: self.has-hover || self.has-focus
                            ? Theme.overlay-color
                            : transparent;
                        clicked => {
                            root.value = option;
                            root.open = false;
                            root.selected(option);
                            popup.close();
                        }

                        HorizontalLayout {
                            padding-left: root.unit;
                            padding-right: root.unit;
                            padding-top: 0.5 * root.unit;
                            padding-bottom: 0.5 * root.unit;
                            spacing: root.unit;

                            Text {
                                horizontal-stretch: 1;
                                text: translate-option(option);
                                color: Theme.primary-foreground;
                                font-size: root.unit;
                                vertical-alignment: center;
                            }

                            if (option == root.value) : Rectangle {
                                width: 0.5 * root.unit;
                                height: 0.5 * root.unit;
                                border-radius: self.width / 2;
                                background: Theme.secondary-accent;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SeasonSelectField inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in-out property <int> value;
    in property <[int]> options: [];
    in-out property <bool> open: false;
    in property <bool> enabled: true;
    // Floor width. The web's season pill is `flex: 0 1 auto`, so it grows with
    // its label rather than clipping it; `field-width` only sets the minimum.
    in property <length> field-width: 15 * root.unit;
    in property <brush> surface-color: Theme.overlay-color;
    callback toggle;
    callback opened;
    callback closed;
    callback selected(int);

    // 1.5u padding on each side, plus the 1.5u caret column and its 1u gap.
    width: max(root.field-width, season-label.preferred-width + 5.5 * root.unit);
    height: 2.75 * root.unit;
    border-radius: root.height / 2;
    background: root.surface-color;
    z: 10000;

    label-button := ButtonSurface {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        enabled: root.enabled;
        accessible-name: root.value > 0 ? @tr("SEASON_NUMBER" => "Season {}", root.value) : @tr("SPECIAL" => "Special");
        clicked => {
            root.toggle();
            if (root.open) {
                root.opened();
            } else {
                root.closed();
            }
        }

        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 1.5 * root.unit;
            padding-right: 1.5 * root.unit;
            spacing: root.unit;

            season-label := Text {
                height: 100%;
                horizontal-stretch: 1;
                text: root.value > 0 ? @tr("SEASON_NUMBER" => "Season {}", root.value) : @tr("SPECIAL" => "Special");
                color: Theme.primary-foreground;
                font-size: root.unit;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }

            ControlIcon {
                width: parent.height * 0.55;
                height: 100%;
                size-ratio: 0.55;
                source: root.open
                    ? @image-url("../assets/images/icons/caret-up.svg")
                    : @image-url("../assets/images/icons/caret-down.svg");
                colorize: Theme.primary-foreground;
                icon-opacity: 0.4;
            }
        }
    }

    if (root.open) : menu := Rectangle {
        x: 0px;
        y: root.height;
        width: root.width;
        height: root.options.length == 0
            ? 3 * root.unit
            : min(root.options.length, 7) * 2.5 * root.unit;
        border-radius: Theme.border-radius;
        background: Theme.modal-color;
        drop-shadow-blur: Theme.outer-glow-blur;
        drop-shadow-color: Theme.outer-glow-color;
        clip: true;
        z: 10001;

        if (root.options.length == 0) : Text {
            width: parent.width;
            height: parent.height;
            text: @tr("No seasons");
            color: Theme.surface-light-90;
            font-size: 1.2 * root.unit;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if (root.options.length > 0) : ScrollView {
            width: parent.width;
            height: parent.height;

            VerticalLayout {
                x: 0px;
                y: 0px;
                width: 100%;
                spacing: 0px;

                for option in root.options : option-button := ButtonSurface {
                    horizontal-stretch: 1;
                    height: 2.5 * root.unit;
                    accessible-name: option > 0 ? @tr("SEASON_NUMBER" => "Season {}", option) : @tr("SPECIAL" => "Special");
                    background: self.has-hover || self.has-focus
                        ? Theme.overlay-color
                        : transparent;
                    clicked => { root.selected(option); }

                    HorizontalLayout {
                        padding-left: root.unit;
                        padding-right: root.unit;
                        padding-top: 0.5 * root.unit;
                        padding-bottom: 0.5 * root.unit;
                        spacing: root.unit;

                        Text {
                            horizontal-stretch: 1;
                            text: option > 0 ? @tr("SEASON_NUMBER" => "Season {}", option) : @tr("SPECIAL" => "Special");
                            color: Theme.primary-foreground;
                            font-size: root.unit;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if (option == root.value) : Rectangle {
                            width: 0.5 * root.unit;
                            height: 0.5 * root.unit;
                            border-radius: self.width / 2;
                            background: Theme.secondary-accent;
                        }
                    }
                }
            }
        }
    }
}
