import { Theme } from "../theme.slint";

export component SkeletonBlock inherits Rectangle {
    in property <length> radius: Theme.border-radius;
    in property <color> base-color: Theme.skeleton-base;
    property <bool> shimmer: false;

    init => { root.shimmer = true; }

    border-radius: root.radius;
    background: root.base-color;
    opacity: root.shimmer ? 0.4 : 0.85;
    clip: true;

    animate opacity {
        duration: 900ms;
        easing: ease-in-out;
        iteration-count: -1;
        direction: alternate;
    }
}

export component SearchHint inherits Rectangle {
    in property <length> unit: 16px;
    in property <image> icon-source;
    in property <string> label;

    width: 9 * root.unit;
    height: 11 * root.unit;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 1.5 * root.unit;

        HorizontalLayout {
            alignment: center;
            Image {
                width: 4 * root.unit;
                height: 4 * root.unit;
                source: root.icon-source;
                colorize: Theme.text-primary;
                opacity: 0.4;
                image-fit: contain;
            }
        }
        Text {
            width: parent.width;
            text: root.label;
            color: Theme.text-primary;
            opacity: 0.4;
            font-size: 1.2 * root.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component EmptyState inherits Rectangle {
    in property <length> unit: 16px;
    in property <image> icon-source;
    in property <string> title;
    in property <string> message: "";
    in property <length> icon-size: 6 * root.unit;

    horizontal-stretch: 1;
    background: transparent;

    VerticalLayout {
        width: 100%;
        alignment: center;
        spacing: 0.85 * root.unit;
        padding-left: root.unit;
        padding-right: root.unit;
        padding-top: root.unit;
        padding-bottom: root.unit;

        HorizontalLayout {
            alignment: center;
            Image {
                width: root.icon-size;
                height: root.icon-size;
                source: root.icon-source;
                colorize: Theme.text-primary;
                opacity: 0.3;
                image-fit: contain;
            }
        }
        Text {
            width: 100%;
            text: root.title;
            color: Theme.text-secondary;
            font-size: 1.15 * root.unit;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if (root.message != "") : Text {
            width: 100%;
            text: root.message;
            color: Theme.text-muted;
            font-size: 0.9 * root.unit;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
