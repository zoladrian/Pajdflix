import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ButtonSurface } from "button.slint";
import { Slider } from "slider.slint";
import { ToggleSwitch } from "toggle.slint";
import { OnboardingHelp } from "onboarding_help.slint";

export component OnboardingModal inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <int> active-step: 0;
    in property <length> unit: Theme.root-font-size;

    // Interactive settings bound to onboarding
    in-out property <int> selected-language-idx: 0;
    in-out property <[string]> available-languages: [
        "English (United States)",
        "English (United Kingdom)",
        "Español (España)",
        "Español (Latinoamérica)",
        "中文 (中国)",
        "日本語",
        "Français",
        "Deutsch",
        "Italiano"
    ];

    in-out property <int> selected-upscaler-preset: 0; // 0: Off, 1: Anime4K Mode A, 7: FSR
    in property <[bool]> upscaler-preset-available: [true, false, false, false, false, false, false, false];
    in property <string> upscaler-status: "Checking GPU support…";
    in-out property <float> seek-duration-seconds: 10.0;
    in-out property <bool> hardware-acceleration-enabled: true;
    in-out property <bool> auto-subtitles-enabled: true;
    in-out property <bool> discord-rpc-enabled: true;
    in-out property <bool> background-playback-enabled: true;
    in-out property <bool> seeding-enabled: false;
    in-out property <bool> pause-on-minimize-enabled: false;
    in-out property <styled-text> changelog-text;

    private property <int> active-help-id: -1;
    private property <length> help-anchor-x;
    private property <length> help-anchor-y;
    private property <[string]> help-titles: [
        @tr("Język aplikacji"), @tr("Anime4K — do animacji"), @tr("AMD FSR — skalowanie obrazu"),
        @tr("Bez dodatkowych filtrów — bez dodatkowych filtrów"), @tr("Długość skoku przy przewijaniu"),
        @tr("Akceleracja sprzętowa"), @tr("Automatyczny wybór napisów"), @tr("Status na Discordzie"),
        @tr("Odtwarzanie w tle"), @tr("Udostępnianie torrentów"), @tr("Pauza po minimalizacji")
    ];
    private property <[string]> help-descriptions: [
        @tr("Zmienia język menu i komunikatów. Nie zmienia języka filmu ani napisów — ich preferencje ustawisz osobno.\n\nWybierz język, w którym najwygodniej Ci korzystać z aplikacji. Później możesz go zmienić w Ustawieniach."),
        @tr("Filtr obrazu przeznaczony głównie do anime i kreskówek. Może wyostrzyć kontury przy powiększaniu filmu, ale mocniej obciąża kartę graficzną i czasem zmienia wygląd obrazu.\n\nWybierz do animacji. Jeśli obraz przycina lub wygląda zbyt ostro, wybierz Bez dodatkowych filtrów. Wyszarzona karta oznacza, że tryb nie jest obecnie dostępny."),
        @tr("Powiększa i wyostrza obraz, np. film 720p na większym ekranie. Działa także na kartach innych producentów, nie tylko AMD. Nie zamieni słabego nagrania w prawdziwe 4K.\n\nWypróbuj przy filmach o niższej rozdzielczości. Jeśli obraz jest zbyt ostry lub odtwarzanie przycina, wybierz Bez dodatkowych filtrów."),
        @tr("Odtwarza obraz bez dodatkowych filtrów Anime4K i FSR. Odtwarzacz nadal dopasowuje film do wielkości okna.\n\nTo dobry wybór na początek, do materiałów w wysokiej jakości i dla słabszego komputera. Nie wyłącza akceleracji sprzętowej — to osobne ustawienie."),
        @tr("Określa, o ile sekund przesunie się film po pojedynczym użyciu przycisku przewijania. Na przykład 10 s oznacza skok o 10 sekund do przodu lub do tyłu.\n\nZacznij od 10 s. Mniejsza wartość ułatwia dokładne cofanie, większa — szybkie pomijanie fragmentów. Nie zmienia prędkości odtwarzania."),
        @tr("Przekazuje dekodowanie filmu karcie graficznej zamiast obciążać głównie procesor. Zwykle zmniejsza zużycie procesora i może oszczędzać baterię.\n\nZwykle warto włączyć. Jeśli zobaczysz czarny lub zielony obraz albo błędy obrazu, spróbuj wyłączyć. To nie jest to samo co filtr FSR lub Anime4K."),
        @tr("Odtwarzacz próbuje sam wybrać dostępne napisy zgodne z Twoimi preferencjami językowymi. Nie tłumaczy napisów i nie gwarantuje, że do każdego filmu znajdą się polskie napisy.\n\nWłącz dla wygody. Jeśli wolisz oglądać bez napisów i wybierać je ręcznie, wyłącz. Język napisów ustawisz w Ustawieniach."),
        @tr("Pozwala pokazywać w Twoim profilu Discord informację o oglądanym filmie lub serialu, gdy działa aplikacja Discord. Inni mogą zobaczyć, co oglądasz.\n\nWłącz tylko wtedy, gdy chcesz udostępniać taki status. Do samego oglądania nie jest potrzebne; dla większej prywatności zostaw wyłączone."),
        @tr("Dotyczy dalszego odtwarzania po schowaniu okna aplikacji, np. aby nadal słyszeć dźwięk. Nie oznacza pobierania całej biblioteki ani seedowania.\n\nW tej wersji zatrzymywanie filmu po minimalizacji kontroluje opcja „Pauza po minimalizacji”. Jeśli nie chcesz dźwięku w tle, włącz właśnie pauzę."),
        @tr("Seedowanie oznacza wysyłanie fragmentów filmu innym uczestnikom torrenta i zużywa transfer wychodzący. To co innego niż pobieranie filmu dla siebie.\n\nW tej prywatnej wersji wysyłanie fragmentów jest zablokowane — ten przełącznik nie włączy seedowania. Pozostała komunikacja protokołu torrent nadal może występować."),
        @tr("Automatycznie wstrzymuje film po zminimalizowaniu okna, aby obraz i dźwięk nie odtwarzały się bez Twojej uwagi.\n\nWłącz, jeśli po schowaniu aplikacji ma zapanować cisza. Wyłącz, jeśli chcesz nadal słuchać filmu w tle. Ta opcja dotyczy odtwarzania, nie ustawień uploadu torrenta.")
    ];
    changed active-step => { root.active-help-id = -1; }
    changed open => { root.active-help-id = -1; }

    callback completed();
    callback skip();
    callback open-github-requested();
    callback language-changed(int);
    callback upscaler-changed(int);
    callback seek-duration-changed(float);
    callback toggle-hwdec(bool);
    callback toggle-auto-subtitles(bool);
    callback toggle-discord-rpc(bool);
    callback toggle-background-playback(bool);
    callback toggle-seeding(bool);
    callback toggle-pause-on-minimize(bool);

    visible: root.open;
    background: Theme.scrim;
    z: 2500;

    TouchArea {
        enabled: root.open;
        clicked => { root.skip(); }
    }

    dialog := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(680px, parent.width * 0.95);
        height: min(520px, parent.height * 0.9);
        border-radius: 20px;
        background: Theme.modal-color;
        border-width: 1px;
        border-color: Theme.card-border;
        drop-shadow-blur: Theme.outer-glow-blur;
        drop-shadow-color: Theme.outer-glow-color;
        TouchArea { } // Prevent click-through

        // Auth-style Ambient Background Image & Gradient Overlay
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/images/intro-background.png");
            image-fit: cover;
            opacity: 0.65;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.main-gradient;
            opacity: 0.85;
        }

        // Top Step Indicator Dots & Pills
        HorizontalLayout {
            x: (parent.width - self.width) / 2;
            y: 18px;
            height: 12px;
            spacing: 6px;
            alignment: center;

            for step-idx in 4 : Rectangle {
                width: root.active-step == step-idx ? 24px : 6px;
                height: 6px;
                border-radius: 3px;
                background: root.active-step == step-idx ? Theme.primary-accent : Theme.primary-foreground.with-alpha(0.3);

                animate width { duration: Theme.motion-control; easing: ease-out; }
                animate background { duration: Theme.motion-control; }
            }
        }

        // ================= SLIDE 0: Welcome & Language =================
        if (root.active-step == 0) : VerticalLayout {
            x: 24px;
            y: 40px;
            width: parent.width - 48px;
            height: 420px;
            spacing: 12px;
            alignment: start;

            HorizontalLayout {
                alignment: center;
                height: 64px;

                Image {
                    width: 64px;
                    height: 64px;
                    source: @image-url("../assets/images/pajdflix.png");
                    image-fit: contain;
                }
            }

            Text {
                text: @tr("Welcome to Pajdflix");
                color: Theme.primary-foreground;
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                height: 22px;
                alignment: center;
                spacing: 8px;
                Text {
                    text: @tr("Before we start");
                    color: Theme.text-secondary;
                    font-size: 14px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                OnboardingHelp {
                    help-id: 0;
                    title: root.help-titles[0];
                    description: root.help-descriptions[0];
                    active-id <=> root.active-help-id;
                    anchor-x <=> root.help-anchor-x;
                    anchor-y <=> root.help-anchor-y;
                }
            }

            // Centered Language Selection Container
            Rectangle {
                x: (parent.width - self.width) / 2;
                width: min(340px, parent.width * 0.85);
                height: 220px;
                border-radius: 12px;
                background: Theme.card-background;
                border-width: 1px;
                border-color: Theme.card-border;
                clip: true;

                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.width;
                    horizontal-scrollbar-policy: always-off;

                    VerticalLayout {
                        width: parent.width;
                        padding: 6px;
                        spacing: 2px;

                        for lang[idx] in root.available-languages : ButtonSurface {
                            width: parent.width - 12px;
                            height: 36px;
                            border-radius: 8px;
                            background: root.selected-language-idx == idx ? Theme.primary-accent : (self.has-hover ? Theme.overlay-hover : transparent);
                            clicked => {
                                root.selected-language-idx = idx;
                                root.language-changed(idx);
                            }

                            Text {
                                text: lang;
                                color: Theme.primary-foreground;
                                font-size: 14px;
                                font-weight: root.selected-language-idx == idx ? 700 : 500;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ================= SLIDE 1: Set up Playback & Upscaling =================
        if (root.active-step == 1) : VerticalLayout {
            x: 24px;
            y: 36px;
            width: parent.width - 48px;
            height: 420px;
            spacing: 10px;
            alignment: start;

            // Centered Header Icon
            HorizontalLayout {
                alignment: center;
                height: 32px;

                Image {
                    width: 32px;
                    height: 32px;
                    source: @image-url("../assets/images/icons/settings-upscaler.svg");
                    colorize: Theme.text-secondary;
                    image-fit: contain;
                }
            }

            Text {
                text: @tr("Set up your playback");
                color: Theme.primary-foreground;
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: @tr("Nie wiesz, co wybrać? Zacznij od Bez dodatkowych filtrów. Najedź na ? lub kliknij, aby poznać opcję.");
                color: Theme.text-secondary;
                font-size: 13px;
                font-weight: 500;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // Upscaler Preset Selection Cards (3 Cards Row)
            Text {
                text: @tr("GPU Video Upscaler");
                color: Theme.text-muted;
                font-size: 12px;
                font-weight: 600;
            }

            HorizontalLayout {
                height: 90px;
                spacing: 12px;
                alignment: space-between;

                // Card 1: Anime4K (HQ)
                card-anime4k := ButtonSurface {
                    width: (parent.width - 24px) / 3;
                    height: 90px;
                    border-radius: 10px;
                    background: root.selected-upscaler-preset == 1 ? Theme.overlay-pressed : Theme.card-background;
                    border-width: root.selected-upscaler-preset == 1 ? 2px : 1px;
                    border-color: root.selected-upscaler-preset == 1 ? Theme.primary-accent : Theme.card-border;
                    enabled: root.upscaler-preset-available.length > 1 && root.upscaler-preset-available[1];
                    opacity: self.enabled ? 1.0 : 0.45;
                    clicked => {
                        root.upscaler-changed(1);
                    }

                    if (root.selected-upscaler-preset == 1) : Rectangle {
                        x: parent.width - 22px;
                        y: 6px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: Theme.primary-accent;

                        Image {
                            width: 10px;
                            height: 10px;
                            source: @image-url("../assets/images/icons/checkmark.svg");
                            colorize: Theme.primary-foreground;
                        }
                    }

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        alignment: center;

                        HorizontalLayout {
                            alignment: center;
                            height: 20px;

                            Image {
                                width: 20px;
                                height: 20px;
                                source: @image-url("../assets/images/icons/hdr.svg");
                                colorize: Theme.primary-foreground;
                            }
                        }

                        Text { text: @tr("Anime4K (HQ)"); color: Theme.primary-foreground; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: @tr("Anime & cartoon upscaling"); color: Theme.text-muted; font-size: 10px; horizontal-alignment: center; wrap: word-wrap; }
                    }
                }

                // Card 2: AMD FSR
                card-fsr := ButtonSurface {
                    width: (parent.width - 24px) / 3;
                    height: 90px;
                    border-radius: 10px;
                    background: root.selected-upscaler-preset == 7 ? Theme.overlay-pressed : Theme.card-background;
                    border-width: root.selected-upscaler-preset == 7 ? 2px : 1px;
                    border-color: root.selected-upscaler-preset == 7 ? Theme.primary-accent : Theme.card-border;
                    enabled: root.upscaler-preset-available.length > 7 && root.upscaler-preset-available[7];
                    opacity: self.enabled ? 1.0 : 0.45;
                    clicked => {
                        root.upscaler-changed(7);
                    }

                    if (root.selected-upscaler-preset == 7) : Rectangle {
                        x: parent.width - 22px;
                        y: 6px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: Theme.primary-accent;

                        Image {
                            width: 10px;
                            height: 10px;
                            source: @image-url("../assets/images/icons/checkmark.svg");
                            colorize: Theme.primary-foreground;
                        }
                    }

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        alignment: center;

                        HorizontalLayout {
                            alignment: center;
                            height: 20px;

                            Image {
                                width: 20px;
                                height: 20px;
                                source: @image-url("../assets/images/icons/star.svg");
                                colorize: Theme.primary-foreground;
                            }
                        }

                        Text { text: @tr("AMD FSR"); color: Theme.primary-foreground; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: @tr("Spatial upscaling for 4K"); color: Theme.text-muted; font-size: 10px; horizontal-alignment: center; wrap: word-wrap; }
                    }
                }

                // Card 3: Bez dodatkowych filtrów
                card-off := ButtonSurface {
                    width: (parent.width - 24px) / 3;
                    height: 90px;
                    border-radius: 10px;
                    background: root.selected-upscaler-preset == 0 ? Theme.overlay-pressed : Theme.card-background;
                    border-width: root.selected-upscaler-preset == 0 ? 2px : 1px;
                    border-color: root.selected-upscaler-preset == 0 ? Theme.primary-accent : Theme.card-border;
                    clicked => {
                        root.upscaler-changed(0);
                    }

                    if (root.selected-upscaler-preset == 0) : Rectangle {
                        x: parent.width - 22px;
                        y: 6px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: Theme.primary-accent;

                        Image {
                            width: 10px;
                            height: 10px;
                            source: @image-url("../assets/images/icons/checkmark.svg");
                            colorize: Theme.primary-foreground;
                        }
                    }

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        alignment: center;

                        HorizontalLayout {
                            alignment: center;
                            height: 20px;

                            Image {
                                width: 20px;
                                height: 20px;
                                source: @image-url("../assets/images/icons/close.svg");
                                colorize: Theme.text-muted;
                            }
                        }
                        Text { text: @tr("Bez dodatkowych filtrów"); color: Theme.primary-foreground; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: @tr("Direct libmpv rendering"); color: Theme.text-muted; font-size: 10px; horizontal-alignment: center; wrap: word-wrap; }
                    }
                }
            }

            HorizontalLayout {
                height: 22px;
                spacing: 12px;
                for id in [1, 2, 3] : HorizontalLayout {
                    width: (parent.width - 24px) / 3;
                    alignment: center;
                    OnboardingHelp {
                        help-id: id;
                        title: root.help-titles[id];
                        description: root.help-descriptions[id];
                        active-id <=> root.active-help-id;
                        anchor-x <=> root.help-anchor-x;
                        anchor-y <=> root.help-anchor-y;
                    }
                }
            }

            Text {
                width: parent.width;
                text: root.upscaler-status;
                color: Theme.text-secondary;
                font-size: 11px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // Seek Duration Slider Row
            Rectangle {
                width: parent.width;
                height: 44px;
                border-radius: 10px;
                background: Theme.card-background;
                border-width: 1px;
                border-color: Theme.card-border;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    Text {
                        text: @tr("Seek Duration");
                        color: Theme.text-secondary;
                        font-size: 13px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }

                    OnboardingHelp {
                        help-id: 4;
                        title: root.help-titles[4];
                        description: root.help-descriptions[4];
                        active-id <=> root.active-help-id;
                        anchor-x <=> root.help-anchor-x;
                        anchor-y <=> root.help-anchor-y;
                    }

                    Slider {
                        horizontal-stretch: 1;
                        min-width: 80px;
                        height: 28px;
                        minimum: 5.0;
                        maximum: 30.0;
                        value: root.seek-duration-seconds;
                        changed(val) => {
                            root.seek-duration-seconds = val;
                            root.seek-duration-changed(val);
                        }
                    }

                    Text {
                        text: Math.round(root.seek-duration-seconds) + "s";
                        color: Theme.primary-foreground;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            // Settings Control Cards Row (2 Side-by-side cards)
            HorizontalLayout {
                height: 64px;
                spacing: 12px;

                // HW Acceleration Card
                Rectangle {
                    width: (parent.width - 12px) / 2;
                    height: 64px;
                    border-radius: 10px;
                    background: Theme.card-background;
                    border-width: 1px;
                    border-color: Theme.card-border;

                    HorizontalLayout {
                        padding: 12px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            HorizontalLayout {
                                height: 22px;
                                spacing: 6px;
                                Text { text: @tr("Hardware Acceleration"); color: Theme.primary-foreground; font-size: 13px; font-weight: 600; }
                                OnboardingHelp {
                                    help-id: 5;
                                    title: root.help-titles[5];
                                    description: root.help-descriptions[5];
                                    active-id <=> root.active-help-id;
                                    anchor-x <=> root.help-anchor-x;
                                    anchor-y <=> root.help-anchor-y;
                                }
                            }
                            Text { text: @tr("GPU decoding (D3D11VA)"); color: Theme.text-muted; font-size: 11px; }
                        }

                        ToggleSwitch {
                            checked <=> root.hardware-acceleration-enabled;
                            toggled => { root.toggle-hwdec(root.hardware-acceleration-enabled); }
                        }
                    }
                }

                // Auto Subtitles Card
                Rectangle {
                    width: (parent.width - 12px) / 2;
                    height: 64px;
                    border-radius: 10px;
                    background: Theme.card-background;
                    border-width: 1px;
                    border-color: Theme.card-border;

                    HorizontalLayout {
                        padding: 12px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            HorizontalLayout {
                                height: 22px;
                                spacing: 6px;
                                Text { text: @tr("Auto-select Subtitles"); color: Theme.primary-foreground; font-size: 13px; font-weight: 600; }
                                OnboardingHelp {
                                    help-id: 6;
                                    title: root.help-titles[6];
                                    description: root.help-descriptions[6];
                                    active-id <=> root.active-help-id;
                                    anchor-x <=> root.help-anchor-x;
                                    anchor-y <=> root.help-anchor-y;
                                }
                            }
                            Text { text: @tr("Pick preferred subtitles"); color: Theme.text-muted; font-size: 11px; }
                        }

                        ToggleSwitch {
                            checked <=> root.auto-subtitles-enabled;
                            toggled => { root.toggle-auto-subtitles(root.auto-subtitles-enabled); }
                        }
                    }
                }
            }
        }

        // ================= SLIDE 2: Stay Connected & Integrations =================
        if (root.active-step == 2) : VerticalLayout {
            x: 24px;
            y: 36px;
            width: parent.width - 48px;
            height: 420px;
            spacing: 14px;
            alignment: start;

            // Centered Top Icon
            HorizontalLayout {
                alignment: center;
                height: 32px;

                Image {
                    width: 32px;
                    height: 32px;
                    source: @image-url("../assets/images/icons/network.svg");
                    colorize: Theme.text-secondary;
                    image-fit: contain;
                }
            }

            Text {
                text: @tr("Stay connected");
                color: Theme.primary-foreground;
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: @tr("Link Pajdflix with your other apps and services.");
                color: Theme.text-secondary;
                font-size: 14px;
                font-weight: 500;
                horizontal-alignment: center;
            }

            // 2x2 Grid of Integration Cards
            VerticalLayout {
                spacing: 12px;

                // Row 1
                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        width: (parent.width - 12px) / 2;
                        height: 68px;
                        border-radius: 10px;
                        background: Theme.card-background;
                        border-width: 1px;
                        border-color: Theme.card-border;

                        HorizontalLayout {
                            padding: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 6px;
                                    Text { text: @tr("Discord Rich Presence"); color: Theme.primary-foreground; font-size: 13px; font-weight: 600; }
                                    OnboardingHelp {
                                        help-id: 7;
                                        title: root.help-titles[7];
                                        description: root.help-descriptions[7];
                                        active-id <=> root.active-help-id;
                                        anchor-x <=> root.help-anchor-x;
                                        anchor-y <=> root.help-anchor-y;
                                    }
                                }
                                Text { text: @tr("Show what you watch on Discord."); color: Theme.text-muted; font-size: 11px; }
                            }

                            ToggleSwitch {
                                checked <=> root.discord-rpc-enabled;
                                toggled => { root.toggle-discord-rpc(root.discord-rpc-enabled); }
                            }
                        }
                    }

                    Rectangle {
                        width: (parent.width - 12px) / 2;
                        height: 68px;
                        border-radius: 10px;
                        background: Theme.card-background;
                        border-width: 1px;
                        border-color: Theme.card-border;

                        HorizontalLayout {
                            padding: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 6px;
                                    Text { text: @tr("Background Playback"); color: Theme.primary-foreground; font-size: 13px; font-weight: 600; }
                                    OnboardingHelp {
                                        help-id: 8;
                                        title: root.help-titles[8];
                                        description: root.help-descriptions[8];
                                        active-id <=> root.active-help-id;
                                        anchor-x <=> root.help-anchor-x;
                                        anchor-y <=> root.help-anchor-y;
                                    }
                                }
                                Text { text: @tr("Keep audio playing when minimized."); color: Theme.text-muted; font-size: 11px; }
                            }

                            ToggleSwitch {
                                checked <=> root.background-playback-enabled;
                                toggled => { root.toggle-background-playback(root.background-playback-enabled); }
                            }
                        }
                    }
                }

                // Row 2
                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        width: (parent.width - 12px) / 2;
                        height: 68px;
                        border-radius: 10px;
                        background: Theme.card-background;
                        border-width: 1px;
                        border-color: Theme.card-border;

                        HorizontalLayout {
                            padding: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 6px;
                                    Text { text: @tr("Torrent Seeding"); color: Theme.primary-foreground; font-size: 13px; font-weight: 600; }
                                    OnboardingHelp {
                                        help-id: 9;
                                        title: root.help-titles[9];
                                        description: root.help-descriptions[9];
                                        active-id <=> root.active-help-id;
                                        anchor-x <=> root.help-anchor-x;
                                        anchor-y <=> root.help-anchor-y;
                                    }
                                }
                                Text { text: @tr("Wysyłanie kawałków jest zablokowane w tym buildzie."); color: Theme.text-muted; font-size: 11px; }
                            }

                            ToggleSwitch {
                                enabled: false;
                                checked: false;
                                toggled => { }
                            }
                        }
                    }

                    Rectangle {
                        width: (parent.width - 12px) / 2;
                        height: 68px;
                        border-radius: 10px;
                        background: Theme.card-background;
                        border-width: 1px;
                        border-color: Theme.card-border;

                        HorizontalLayout {
                            padding: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 6px;
                                    Text { text: @tr("Pause on Minimize"); color: Theme.primary-foreground; font-size: 13px; font-weight: 600; }
                                    OnboardingHelp {
                                        help-id: 10;
                                        title: root.help-titles[10];
                                        description: root.help-descriptions[10];
                                        active-id <=> root.active-help-id;
                                        anchor-x <=> root.help-anchor-x;
                                        anchor-y <=> root.help-anchor-y;
                                    }
                                }
                                Text { text: @tr("Pause video when minimized."); color: Theme.text-muted; font-size: 11px; }
                            }

                            ToggleSwitch {
                                checked <=> root.pause-on-minimize-enabled;
                                toggled => { root.toggle-pause-on-minimize(root.pause-on-minimize-enabled); }
                            }
                        }
                    }
                }
            }

            Text {
                text: @tr("More integrations and options live in Settings → Interface & Player.");
                color: Theme.text-muted;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }

        // ================= SLIDE 3: What's New & GitHub Changelogs =================
        if (root.active-step == 3) : VerticalLayout {
            x: 24px;
            y: 36px;
            width: parent.width - 48px;
            height: 420px;
            spacing: 12px;
            alignment: start;

            // Centered Top Icon
            HorizontalLayout {
                alignment: center;
                height: 32px;

                Image {
                    width: 32px;
                    height: 32px;
                    source: @image-url("../assets/images/icons/megaphone.svg");
                    colorize: Theme.text-secondary;
                    image-fit: contain;
                }
            }

            Text {
                text: @tr("What's New in Pajdflix");
                color: Theme.primary-foreground;
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: @tr("Latest release highlights and GitHub changelogs.");
                color: Theme.text-secondary;
                font-size: 13px;
                font-weight: 500;
                horizontal-alignment: center;
            }

            // Scrollable Changelogs Container
            Rectangle {
                width: parent.width;
                height: 220px;
                border-radius: 12px;
                background: Theme.card-background;
                border-width: 1px;
                border-color: Theme.card-border;
                clip: true;

                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.width;
                    horizontal-scrollbar-policy: always-off;

                    VerticalLayout {
                        width: parent.width;
                        padding: 14px;
                        spacing: 10px;

                        StyledText {
                            width: parent.width;
                            text: root.changelog-text;
                            default-color: Theme.primary-foreground;
                            default-font-size: 12px;
                        }
                    }
                }
            }

            // GitHub Repository Button
            HorizontalLayout {
                alignment: center;

                ButtonSurface {
                    width: 210px;
                    height: 36px;
                    border-radius: 18px;
                    background: Theme.overlay;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    clicked => { root.open-github-requested(); }

                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;

                            Image {
                                width: 16px;
                                height: 16px;
                                source: @image-url("../assets/images/icons/open-in-browser.svg");
                                colorize: Theme.primary-foreground;
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: @tr("Visit GitHub Repository");
                            color: Theme.primary-foreground;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Footer Actions Bar (Previous link on left, Get Started / Next pill on right)
        HorizontalLayout {
            x: 28px;
            y: parent.height - 56px;
            width: parent.width - 56px;
            height: 40px;
            alignment: space-between;

            // Previous Button (Text Link)
            if (root.active-step > 0) : ButtonSurface {
                width: 80px;
                height: 36px;
                clicked => { root.active-step -= 1; }

                Text {
                    text: @tr("Previous");
                    color: Theme.text-secondary;
                    font-size: 14px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
            if (root.active-step == 0) : Rectangle { width: 80px; } // Spacer

            // Next / Get Started Primary Pill Button
            ButtonSurface {
                width: root.active-step == 3 ? 130px : 100px;
                height: 38px;
                border-radius: 19px;
                background: Theme.primary-accent;
                clicked => {
                    if (root.active-step < 3) {
                        root.active-step += 1;
                    } else {
                        root.completed();
                    }
                }

                Text {
                    text: root.active-step == 3 ? @tr("Get Started") : @tr("Next");
                    color: Theme.primary-foreground;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    // A single tooltip above all slides, clamped to the window on either side.
    if (root.active-help-id >= 0) : Rectangle {
        width: min(380px, parent.width - 32px);
        height: help-layout.preferred-height;
        x: max(16px, min(root.help-anchor-x - root.absolute-position.x + 24px, parent.width - self.width - 16px));
        y: max(16px, min(
            root.help-anchor-y - root.absolute-position.y + 28px + self.height <= parent.height - 16px
                ? root.help-anchor-y - root.absolute-position.y + 28px
                : root.help-anchor-y - root.absolute-position.y - self.height - 8px,
            parent.height - self.height - 16px));
        background: Theme.modal-color;
        border-width: 1px;
        border-color: Theme.primary-accent;
        border-radius: 12px;
        drop-shadow-blur: Theme.outer-glow-blur;
        drop-shadow-color: Theme.outer-glow-color;
        z: 3000;
        TouchArea { }
        help-layout := VerticalLayout {
            width: parent.width;
            padding: 14px;
            spacing: 8px;
            Text {
                text: root.help-titles[root.active-help-id];
                color: Theme.primary-foreground;
                font-size: 14px;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: root.help-descriptions[root.active-help-id];
                color: Theme.text-secondary;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}
